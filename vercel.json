{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/vitalscan run build",
  "outputDirectory": "artifacts/vitalscan/dist",
  "rewrites": [
    {
      "source": "/((?!assets/|fhvitals/).*)",
      "destination": "/index.html"
    }
  ]
}
